# Copy to .env and fill in. Never commit .env.
# Comments go on their OWN lines — do NOT put "# ..." after a value.

# --- LLM (pluggable; default Groq free tier) ---
# LLM_PROVIDER: groq | ollama | gemini | claude | openai
LLM_PROVIDER=groq
# free key at console.groq.com
GROQ_API_KEY=your_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# used when LLM_PROVIDER=ollama (local/private)
OLLAMA_MODEL=llama3.1
# used when LLM_PROVIDER=claude (top quality) — install: uv sync --extra claude
# ANTHROPIC_API_KEY is OPTIONAL: if blank, the SDK uses your `ant auth login` CLI profile
# (or ANTHROPIC_AUTH_TOKEN). Set a key only to pin a specific one.
# CLAUDE_MODEL: claude-opus-4-8 (best) | claude-sonnet-5 | claude-haiku-4-5 (cheapest)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# --- Chat platform ---
# discord | whatsapp
BOT_PLATFORM=discord

# --- Discord ---
# discord.com/developers -> New Application -> Bot
DISCORD_TOKEN=your_token_here
# comma-separated whitelist of your numeric Discord user id(s)
DISCORD_ALLOWED_IDS=123456789012345678
# channel id for the morning digest (leave blank to disable)
DISCORD_DIGEST_CHANNEL_ID=

# --- WhatsApp Cloud API ---
# Set BOT_PLATFORM=whatsapp, then create a Meta app with the WhatsApp product enabled.
# Webhook callback path defaults to /whatsapp/webhook.
WHATSAPP_VERIFY_TOKEN=choose_a_long_random_string
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# comma-separated sender IDs / phone numbers allowed to use the bot.
# Leave blank for first run; the bot will reply with your sender ID.
WHATSAPP_ALLOWED_NUMBERS=
# optional but recommended in production; enables X-Hub-Signature-256 verification
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_HOST=0.0.0.0
WHATSAPP_PORT=8080
WHATSAPP_WEBHOOK_PATH=/whatsapp/webhook

# --- Storage / brain ---
DB_PATH=./brain.db
# prune bulky article text older than this many days
ARTICLE_RETENTION_DAYS=90

# --- Agent behavior ---
# safety cap on the tool-calling loop
MAX_TOOL_ITERS=6

# --- Scheduler ---
MARKET_TZ=America/New_York
# local time (MARKET_TZ) for the morning digest
DIGEST_TIME=08:30

# --- Web search ---
# ddgs | tavily | mcp
WEB_SEARCH_BACKEND=ddgs
# only if WEB_SEARCH_BACKEND=tavily
TAVILY_API_KEY=
# --- Social signals (optional; Work-stream C) — install: uv sync --extra social ---
# Google Trends works with just the [social] extra (no key). Reddit needs a free "script"
# app (reddit.com/prefs/apps) because unauthenticated .json access is 403-blocked.
# StockTwits' public API is Cloudflare-gated (403) and degrades to unavailable.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# only if WEB_SEARCH_BACKEND=mcp (Work-stream G5, read-only research server).
# Provide ONE of: a stdio launch command, or an SSE/HTTP URL. Requires: uv sync --extra mcp
# Examples:
#   MCP_SEARCH_COMMAND=npx -y @modelcontextprotocol/server-brave-search   (needs BRAVE_API_KEY)
#   MCP_SEARCH_URL=http://localhost:8080/sse
MCP_SEARCH_COMMAND=
MCP_SEARCH_URL=
# Name of the read-only search/fetch tool to call on that server (default: search)
MCP_SEARCH_TOOL=search

# --- Misc ---
LOG_LEVEL=INFO
# off | local (route portfolio reasoning to Ollama)
PRIVACY_MODE=off
