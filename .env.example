# Copy to .env and fill in. Never commit .env.

# --- LLM (pluggable; default Groq free tier) ---
LLM_PROVIDER=groq                       # groq | ollama | gemini | claude | openai
GROQ_API_KEY=your_key_here              # free at console.groq.com
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_MODEL=llama3.1                   # used when LLM_PROVIDER=ollama (local/private)

# --- Discord ---
DISCORD_TOKEN=your_token_here           # discord.com/developers -> New Application -> Bot
DISCORD_ALLOWED_IDS=123456789012345678  # comma-separated whitelist of your Discord user id(s)
DISCORD_DIGEST_CHANNEL_ID=              # channel id for the morning digest (Phase 2)

# --- Storage / brain ---
DB_PATH=./brain.db
ARTICLE_RETENTION_DAYS=90               # prune bulky article text older than this (Phase 2)

# --- Agent behavior ---
MAX_TOOL_ITERS=6                        # safety cap on the tool-calling loop

# --- Scheduler (Phase 2) ---
MARKET_TZ=America/New_York
DIGEST_TIME=08:30                       # local time (MARKET_TZ) for the morning digest

# --- Web search (Phase 1) ---
WEB_SEARCH_BACKEND=ddgs                 # ddgs | tavily | mcp
TAVILY_API_KEY=                         # only if WEB_SEARCH_BACKEND=tavily

# --- Misc ---
LOG_LEVEL=INFO
PRIVACY_MODE=off                        # off | local (route portfolio reasoning to Ollama)
